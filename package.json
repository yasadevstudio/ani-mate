{
  "name": "ani-mate",
  "version": "0.5.0",
  "description": "ANI-MATE - Free Anime For All",
  "main": "main.js",
  "author": "YASA Development Studio",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux --x64"
  },
  "dependencies": {
    "@consumet/extensions": "^1.8.8",
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.yasa.ani-mate",
    "productName": "ANI-MATE",
    "copyright": "Copyright 2026 YASA Development Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "electron-net-bridge.js",
      "server/**/*",
      "ui/**/*"
    ],
    "asarUnpack": [
      "server/**/*",
      "ui/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "YASADevStudio",
      "repo": "ani-mate"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ANI-MATE",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "runAfterFinish": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "AudioVideo",
      "synopsis": "Watch anime",
      "description": "ANI-MATE streams anime from multiple sources with a local resolver.",
      "desktop": {
        "Name": "ANI-MATE",
        "Comment": "Watch anime",
        "Categories": "AudioVideo;Video;Player;"
      },
      "maintainer": "YASA Development Studio <yasadevstudio@users.noreply.github.com>"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libsecret-1-0"
      ]
    }
  }
}
