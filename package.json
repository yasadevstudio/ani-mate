{
  "name": "ani-mate",
  "version": "0.7.2",
  "description": "ANI-MATE - Free Anime For All",
  "main": "main.js",
  "author": "YASA Development Studio",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux --x64",
    "sync:shared": "node scripts/sync-shared.js",
    "sync:verify": "node scripts/verify-shared.js",
    "test": "npm run test:offline && npm run test:live",
    "test:ui": "node tests/franchise-module.test.js && node scripts/local-suite.js tests/franchise-ui.test.js && node tests/page-playback.test.js && node tests/budget.test.js",
    "test:live": "node scripts/test-live.js",
    "test:worker": "node worker/tests/run.mjs",
    "test:syntax": "node tests/ui-syntax.test.js && node scripts/verify-shared.js",
    "test:dom": "node scripts/test-dom.js",
    "test:offline": "npm run test:syntax && npm run test:names && npm run test:worker && npm run test:ui && npm run test:server",
    "test:server": "node tests/server-net.test.js && node tests/server-search.test.js",
    "smoke": "node scripts/smoke-stream.js",
    "smoke:electron": "node scripts/smoke-electron.js",
    "test:names": "node scripts/check-undefined-names.js",
    "test:sync": "node scripts/test-sync.js",
    "test:phone": "node scripts/test-phone.js"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.yasa.ani-mate",
    "productName": "ANI-MATE",
    "copyright": "Copyright 2026 YASA Development Studio",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "electron-net-bridge.js",
      "server/**/*",
      "ui/**/*"
    ],
    "asarUnpack": [
      "server/**/*",
      "ui/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "YASADevStudio",
      "repo": "ani-mate"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ANI-MATE",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "runAfterFinish": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "AudioVideo",
      "synopsis": "Watch anime",
      "description": "ANI-MATE streams anime from multiple sources with a local resolver.",
      "desktop": {
        "Name": "ANI-MATE",
        "Comment": "Watch anime",
        "Categories": "AudioVideo;Video;Player;"
      },
      "maintainer": "YASA Development Studio <yasadevstudio@users.noreply.github.com>"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libsecret-1-0"
      ],
      "afterInstall": "build/deb-after-install.sh"
    }
  }
}
